# Copy to .env for local runs. Never commit real secrets.
DATABASE_URL=postgres://trade_setups:trade_setups_dev@127.0.0.1:5433/market_data
TEST_DATABASE_URL=postgres://trade_setups:trade_setups_dev@127.0.0.1:5433/market_data_test
API_KEYS=change-me-dev-key
PORT=8081
HOST=127.0.0.1
LOG_LEVEL=info
BYBIT_INGEST_ENABLED=0
# One aggregate REST budget for listing, fresh repair, history and retries.
BYBIT_REST_MAX_RPS=30
BYBIT_REQUEST_TIMEOUT_MS=5000
BYBIT_FRESH_TICK_MS=2000
BYBIT_FRESH_FALLBACK_DELAY_MS=3000
BYBIT_FRESH_REPAIR_MINUTES=5
BYBIT_FRESH_MAX_SYMBOLS=4096
BYBIT_FRESH_CONCURRENCY=8
BYBIT_WS_SHARD_SYMBOLS=200
BYBIT_WS_MAX_PAYLOAD_BYTES=262144
