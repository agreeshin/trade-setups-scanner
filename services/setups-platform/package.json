{
  "name": "@trade-setups/signals-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:test": "tsx src/db/migrate.ts --test",
    "db:ensure-test-db": "tsx src/db/ensure-test-db.ts"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "@sinclair/typebox": "^0.34.52",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "kysely": "^0.29.8",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
